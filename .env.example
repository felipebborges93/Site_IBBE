# ==============================================================================
# VARIÁVEIS DE AMBIENTE - IBBE
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (Banco de Dados e Auth)
# ------------------------------------------------------------------------------
# URL do projeto no Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Chave Anônima pública (Project Settings -> API -> Project API Keys -> anon, public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role Secret - Usado APENAS em rotas de API seguras, NUNCA no frontend!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"


# ------------------------------------------------------------------------------
# YOUTUBE API (Integração de Vídeos)
# ------------------------------------------------------------------------------
# Chave da API do Google Cloud/YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-api-key"

# ID do canal da IBBE no YouTube
YOUTUBE_CHANNEL_ID="your-channel-id"


# ------------------------------------------------------------------------------
# VERCEL KV (Cache Distribuído - Redis)
# ------------------------------------------------------------------------------
# Criado automaticamente ao linkar o projeto na Vercel com um banco KV,
# ou insira manualmente se estiver rodando localmente com um Redis remoto.
KV_REST_API_URL="https://your-kv-url.upstash.io"
KV_REST_API_TOKEN="your-kv-token"


# ------------------------------------------------------------------------------
# SEGURANÇA E OUTROS
# ------------------------------------------------------------------------------
# Telão / API de Exibição de Pedidos de Oração
TELAO_API_TOKEN="seu-token-secreto-para-autorizacao-do-telao"
