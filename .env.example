# ==============================================================================
# Variáveis de Ambiente de Exemplo — Site IBBE Resende
# ==============================================================================
# Renomeie este arquivo para .env.local e preencha com as credenciais reais.
# NUNCA envie chaves de produção ou tokens reais para o controle de versão (Git).

# Supabase — Banco de Dados e Autenticação
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anonima-do-supabase

# Telão / API de Exibição de Pedidos de Oração
TELAO_API_TOKEN=seu-token-secreto-para-autorizacao-do-telao
