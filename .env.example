# ==============================================================================
# VARIÁVEIS DE AMBIENTE - IBBE (Exemplo)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (Banco de Dados e Auth)
# ------------------------------------------------------------------------------
# URL do projeto no Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Chave Anônima pública (Project Settings -> API -> Project API Keys -> anon, public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role Secret - Usado APENAS em rotas de API seguras no servidor, NUNCA no frontend!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# TELÃO E INTEGRAÇÕES
# ------------------------------------------------------------------------------
# Token secreto para autorização da API de exibição no telão
TELAO_API_TOKEN="seu-token-secreto-para-autorizacao-do-telao"

# Webhook do n8n para Automação de Notificação de Oração no WhatsApp
N8N_PRAYER_WEBHOOK_URL="http://localhost:5678/webhook/pedido-oracao"
